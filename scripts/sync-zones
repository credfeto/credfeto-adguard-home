#!/bin/sh

set -e

die() {
    echo
    echo "$@"
    exit 1
}

IMPORT_ALL=false
case "$1" in
    --all) IMPORT_ALL=true ;;
    "")    ;;
    *)     die "Usage: sync-zones [--all]" ;;
esac

SCRIPTDIR="$(dirname "$(readlink -f "$0")")"
BASEDIR="$(dirname "$SCRIPTDIR")"

ENV_FILE="${SCRIPTDIR}/.env"
if [ ! -f "${ENV_FILE}" ]; then
    echo "sync-zones: no .env at ${ENV_FILE} — skipping zone sync."
    echo "sync-zones: copy scripts/.env.example and set DNS_API_TOKEN to enable."
    exit 0
fi

DNS_API_TOKEN="$(grep -E '^[[:space:]]*DNS_API_TOKEN[[:space:]]*=' "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
if [ -z "${DNS_API_TOKEN}" ]; then
    echo "sync-zones: DNS_API_TOKEN not set in ${ENV_FILE} — skipping zone sync."
    exit 0
fi

DNS_API_URL="$(grep -E '^[[:space:]]*DNS_API_URL[[:space:]]*=' "${ENV_FILE}" | tail -n 1 | cut -d= -f2- | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')"
DNS_API_URL="${DNS_API_URL:-https://localhost:53443}"

configure_server() {
    echo "sync-zones: configuring server settings..."
    # dnsTlsCertificatePath=cert.pfx points to the self-signed cert generated by
    # the update script at /data/technitium/config/cert.pfx (mounted as /etc/dns/).
    # dnsTlsCertificatePassword is intentionally empty — the cert has no password.
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/settings/set?token=${DNS_API_TOKEN}&webServiceEnableHttp3=true&enableDnsOverHttps=true&dnsOverHttpsPort=443&enableDnsOverHttp3=true&dnsTlsCertificatePath=cert.pfx&dnsTlsCertificatePassword=" \
        > /dev/null \
        || echo "sync-zones: warning: server settings update failed" >&2
}

import_zone() {
    _ZONE_NAME="$(basename "$1" .db)"
    echo "sync-zones: importing ${_ZONE_NAME}..."
    # Create zone first — zones/import requires it to exist; ignore error if already present
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/zones/create?token=${DNS_API_TOKEN}&zone=${_ZONE_NAME}&type=Primary" \
        > /dev/null 2>&1 || true
    curl -sf -k -X POST \
        "${DNS_API_URL}/api/zones/import?token=${DNS_API_TOKEN}&zone=${_ZONE_NAME}&overwrite=true" \
        -F "zoneFile=@$1" \
        || { echo "sync-zones: import failed for ${_ZONE_NAME}" >&2; return 1; }
}

if [ "${IMPORT_ALL}" = "true" ]; then
    configure_server
    echo "sync-zones: importing all zones from ${BASEDIR}/zones/..."
    ERRORS=0
    for DB_FILE in "${BASEDIR}/zones"/*.db; do
        import_zone "${DB_FILE}" || ERRORS=$((ERRORS + 1))
    done
    [ "${ERRORS}" -eq 0 ] || die "sync-zones: ${ERRORS} zone(s) failed to import."
    echo "sync-zones: all zones imported."
    exit 0
fi

PREV_HEAD="$(git -C "${BASEDIR}" rev-parse HEAD)"

git -C "${BASEDIR}" pull

NEW_HEAD="$(git -C "${BASEDIR}" rev-parse HEAD)"

if [ "${PREV_HEAD}" = "${NEW_HEAD}" ]; then
    echo "sync-zones: no changes pulled, nothing to do."
    exit 0
fi

CHANGED_ZONES="$(git -C "${BASEDIR}" diff --name-only "${PREV_HEAD}..${NEW_HEAD}" -- 'zones/*.db')"

if [ -z "${CHANGED_ZONES}" ]; then
    echo "sync-zones: no zone changes in this pull, skipping import."
    exit 0
fi

echo "sync-zones: zone changes detected, importing..."
ERRORS=0
for ZONE_FILE in ${CHANGED_ZONES}; do
    ABS_FILE="${BASEDIR}/${ZONE_FILE}"
    if [ ! -f "${ABS_FILE}" ]; then
        echo "sync-zones: $(basename "${ZONE_FILE}" .db) removed from git — delete via admin UI if needed"
        continue
    fi
    import_zone "${ABS_FILE}" || ERRORS=$((ERRORS + 1))
done

[ "${ERRORS}" -eq 0 ] || die "sync-zones: ${ERRORS} zone(s) failed to import."
echo "sync-zones: done."
