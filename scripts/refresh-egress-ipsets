#!/bin/sh

# Keeps the dns-egress-* firewalld ipsets in sync with current DNS
# resolution for domains that have no stable static IP/CIDR to allow
# (CDN-fronted). See docs/network/egress-whitelist.md, open questions
# 9-10, for why these specific domains need this and why a static rule
# doesn't work for them.
#
# Runs as root - via the dns-egress-refresh.timer systemd unit that
# ./update installs, or manually with sudo.

set -eu

die() {
    echo
    echo "$@"
    exit 1
}

[ "$(id -u)" -eq 0 ] || die "must run as root"

# domain:slug pairs, not a mechanical domain-to-slug derivation — the
# kernel's ipset name limit is 32 bytes (IPSET_MAXNAMELEN), so slugs stay
# short by hand rather than risking a future domain producing a name
# that's silently too long. Keep in sync with the ipset/rule slug list in
# ./update if a domain is ever added, removed or renamed here.
DOMAIN_SLUGS="github.com:github cdn-mirror.chaotic.cx:chaotic"

CHANGED=false

# firewalld's own ipset entries are the source of truth for "current" -
# this script never keeps state of its own between runs. No-op when the
# wanted and current sets already match, so the reload at the end can be
# skipped on the (overwhelmingly common) unchanged run.
sync_ipset() {
    _set="$1"
    _wanted="$2"
    _current="$(firewall-cmd --permanent --ipset="${_set}" --get-entries 2>/dev/null || true)"

    if [ "$(printf '%s\n' "${_wanted}" | sort -u)" = "$(printf '%s\n' "${_current}" | sort -u)" ]; then
        return 0
    fi
    CHANGED=true

    printf '%s\n' "${_current}" | while IFS= read -r _ip; do
        [ -n "${_ip}" ] || continue
        printf '%s\n' "${_wanted}" | grep -Fqx "${_ip}" \
            || firewall-cmd --permanent --ipset="${_set}" --remove-entry="${_ip}" > /dev/null
    done

    printf '%s\n' "${_wanted}" | while IFS= read -r _ip; do
        [ -n "${_ip}" ] || continue
        printf '%s\n' "${_current}" | grep -Fqx "${_ip}" \
            || firewall-cmd --permanent --ipset="${_set}" --add-entry="${_ip}" > /dev/null
    done
}

for _pair in ${DOMAIN_SLUGS}; do
    _domain="${_pair%%:*}"
    _slug="${_pair#*:}"

    # One lookup per domain - separate per-family lookups can return
    # divergent snapshots under CDN rotation, and the NAT64 forms are
    # derived from the v4 answers, so a split view causes spurious churn.
    # A transiently unresolvable domain is skipped rather than aborting -
    # exiting mid-run after an earlier domain's permanent entries were
    # already mutated would strand runtime state (the reload below would
    # never run: later runs see permanent==wanted and skip it).
    _ahosts="$(getent ahosts "${_domain}")" || continue
    _v4="$(printf '%s\n' "${_ahosts}" | awk '$1 !~ /:/ {print $1}' | sort -u)"

    # v6 wanted-set = native AAAA answers plus the NAT64 well-known-prefix
    # (64:ff9b::/96, RFC 6052) form of every IPv4 address, deduplicated.
    # This network runs DNS64, so IPv6-preferring clients reach IPv4-only
    # destinations via these synthesised addresses - but whether a lookup
    # returns the synthesised AAAA depends on resolver state at that
    # instant, so the forms are computed deterministically instead
    # (canonical hex, stable against firewalld's entry normalisation).
    _v6="$( {
        printf '%s\n' "${_ahosts}" | awk '$1 ~ /:/ {print $1}'
        printf '%s\n' "${_v4}" | awk -F. 'NF == 4 {printf "64:ff9b::%02x%02x:%02x%02x\n", $1, $2, $3, $4}'
    } | sort -u)"

    sync_ipset "dns-egress-${_slug}-v4" "${_v4}"
    sync_ipset "dns-egress-${_slug}-v6" "${_v6}"
done

if [ "${CHANGED}" = "true" ]; then
    firewall-cmd --reload
fi
