#!/bin/sh

# Keeps the dns-egress-* firewalld ipsets in sync with current DNS
# resolution for domains that have no stable static IP/CIDR to allow
# (CDN-fronted). See docs/network/egress-whitelist.md, open questions
# 9-10, for why these specific domains need this and why a static rule
# doesn't work for them.
#
# Run directly, or via the dns-egress-refresh.timer systemd unit that
# ./update installs.

set -eu

# domain:slug pairs, not a mechanical domain-to-slug derivation — the
# kernel's ipset name limit is 32 bytes (IPSET_MAXNAMELEN), so slugs stay
# short by hand rather than risking a future domain producing a name
# that's silently too long. Keep in sync with the ipset/rule names in
# ./update if a domain is ever added, removed or renamed here.
DOMAIN_SLUGS="github.com:github cdn-mirror.chaotic.cx:chaotic"

resolve_family() {
    _domain="$1"
    _family="$2"
    case "${_family}" in
        v4) getent ahosts "${_domain}" | awk '$1 !~ /:/ {print $1}' | sort -u ;;
        v6) getent ahosts "${_domain}" | awk '$1 ~ /:/ {print $1}' | sort -u ;;
    esac
}

# The NAT64 well-known prefix (64:ff9b::/96, RFC 6052) embeds the IPv4
# address in the last 32 bits. This network runs DNS64, so IPv6-preferring
# clients reach IPv4-only destinations via these synthesised addresses -
# but whether a getent lookup returns the synthesised AAAA depends on
# resolver state at that instant, so relying on resolution makes entries
# flap in and out. Compute the form deterministically from every IPv4
# address instead. Canonical hex output (not the a.b.c.d mixed notation)
# so string comparison against firewalld's --get-entries stays stable.
nat64_for() {
    printf '%s' "$1" | awk -F. '{printf "64:ff9b::%02x%02x:%02x%02x\n", $1, $2, $3, $4}'
}

# firewalld's own ipset entries are the source of truth for "current" -
# this script never keeps state of its own between runs.
sync_ipset() {
    _set="$1"
    _wanted="$2"
    _current="$(sudo firewall-cmd --permanent --ipset="${_set}" --get-entries 2>/dev/null || true)"

    printf '%s\n' "${_current}" | while IFS= read -r _ip; do
        [ -n "${_ip}" ] || continue
        printf '%s\n' "${_wanted}" | grep -qx "${_ip}" \
            || sudo firewall-cmd --permanent --ipset="${_set}" --remove-entry="${_ip}" > /dev/null
    done

    printf '%s\n' "${_wanted}" | while IFS= read -r _ip; do
        [ -n "${_ip}" ] || continue
        printf '%s\n' "${_current}" | grep -qx "${_ip}" \
            || sudo firewall-cmd --permanent --ipset="${_set}" --add-entry="${_ip}" > /dev/null
    done
}

for _pair in ${DOMAIN_SLUGS}; do
    _domain="${_pair%%:*}"
    _slug="${_pair#*:}"
    _v4="$(resolve_family "${_domain}" v4)"

    # v6 wanted-set = native AAAA answers plus the computed NAT64 form of
    # every IPv4 address, deduplicated.
    _nat64=""
    for _ip in ${_v4}; do
        _nat64="${_nat64}$(nat64_for "${_ip}")
"
    done
    _v6="$(printf '%s\n%s' "$(resolve_family "${_domain}" v6)" "${_nat64}" | sort -u)"

    sync_ipset "dns-egress-${_slug}-v4" "${_v4}"
    sync_ipset "dns-egress-${_slug}-v6" "${_v6}"
done

sudo firewall-cmd --reload
