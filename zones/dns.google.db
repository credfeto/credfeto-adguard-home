$ORIGIN dns.google.
$TTL 3600
@ IN SOA dns-server. admin. (
    2       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

; Google public DNS
@ IN A 8.8.8.8
@ IN A 8.8.4.4
@ IN AAAA 2001:4860:4860::8888
@ IN AAAA 2001:4860:4860::8844
