$ORIGIN dns.lan.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

dns-01  IN A 192.168.42.251
dns-02  IN A 192.168.42.252
dns-03  IN A 192.168.42.253
dns-04  IN A 192.168.42.254
