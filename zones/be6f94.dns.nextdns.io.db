$ORIGIN be6f94.dns.nextdns.io.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

; NextDNS (config be6f94)
@ IN A 45.90.28.0
@ IN A 45.90.30.0
@ IN AAAA 2a07:a8c0::
@ IN AAAA 2a07:a8c1::
