$ORIGIN lan.
$TTL 3600
@ IN SOA dns-server. admin. (
    12      ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

dns-01              IN A 192.168.42.101
dns-01              IN AAAA 2a02:8010:61d5:42::101
