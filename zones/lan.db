$ORIGIN lan.
$TTL 3600
@ IN SOA dns-server. admin. (
    3       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

dns-01              IN A 192.168.42.251
dns-02              IN A 192.168.42.252
dns-03              IN A 192.168.42.253
dns-04              IN A 192.168.42.254
proxmox-01          IN A 192.168.86.11
proxmox-02          IN A 192.168.86.12
proxmox-03          IN A 192.168.86.13
proxmox-04          IN A 192.168.86.14
xerox-b210-wired    IN A 192.168.86.156
sql-server          IN A 192.168.90.254
defi                IN A 192.168.150.12
notifications       IN A 192.168.150.15
dev-upgrader-01     IN A 192.168.150.20
dev-upgrader-02     IN A 192.168.150.21
nanoclaw            IN A 192.168.150.23
linux-cache-01      IN A 192.168.150.200
linux-cache-02      IN A 192.168.150.201
arch-vm-test        IN A 192.168.150.135
proxy               IN A 192.168.150.250
monitoring          IN A 192.168.150.135
