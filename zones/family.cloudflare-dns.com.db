$ORIGIN family.cloudflare-dns.com.
$TTL 3600
@ IN SOA dns-server. admin. (
    1       ; serial
    900     ; refresh
    300     ; retry
    604800  ; expire
    300     ; minimum TTL
)
@ IN NS dns-server.

; Cloudflare family DNS (malware + adult content blocking)
@ IN A 1.1.1.3
@ IN A 1.0.0.3
@ IN AAAA 2606:4700:4700::1113
@ IN AAAA 2606:4700:4700::1003
