# Copy this file to .env and set a strong password before running ./update
DNS_ADMIN_PASSWORD=changeme

# When false (default), ./update sets up the dns-egress firewalld policy
# and every confirmed rule, but leaves its target at ACCEPT rather than
# DROP - present and testable, not enforced. Set to true only once it's
# been running cleanly for a while. See docs/network/egress-whitelist.md
# for the destination list, rationale, and remaining open questions.
DNS_EGRESS_ENFORCE=false
