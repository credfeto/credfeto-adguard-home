# Copy this file to .env and set a strong password before running ./update
DNS_ADMIN_PASSWORD=changeme

# Egress lockdown is enforced by default (deny-by-default outbound with
# an explicit allow-list - see docs/network/egress-whitelist.md). Set to
# false to fall back to observation mode (rules present, unmatched
# egress logged but accepted) when validating a new node or diagnosing
# a gap; unset or true means enforce.
DNS_EGRESS_ENFORCE=true
